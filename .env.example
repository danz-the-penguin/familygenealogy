# ==============================================================================
# Family Genealogy - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env or .env.local to configure your local setup:
#   cp .env.example .env
#
# NOTE: Both .env and data/family.json are listed in .gitignore, so your real
# credentials and family genealogy data will NOT be uploaded to GitHub!
# ==============================================================================

# Admin Panel Passcode
# Change this to your custom password to protect admin privileges:
VITE_ADMIN_PASSWORD=admin

# Backend Server Port (for node server.js)
PORT=3001
